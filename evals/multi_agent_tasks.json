  {
    "id": "multi_planner_executor_write",
    "title": "Planner 与 Executor 分权写入",
    "description": "Planner 只读规划，根 Executor 完成唯一写入并留下文件锁证据。",
    "task_type": "workspace_change",
    "difficulty": "medium",
    "suite": "multi_agent",
    "tags": ["multi-agent", "planner", "file-lock"],
    "prompt": "创建 result.txt，内容为 controlled multi-agent。",
    "required_tools": ["create_file"],
    "allow_write": true,
    "permission_mode": "full",
    "orchestration_mode": "planner_executor",
    "agent_count": 1,
    "max_execution_seconds": 30,
    "max_tool_calls": 4,
    "max_tokens": 12000,
    "expected_files": ["result.txt"],
    "actions": [
      {"kind": "final", "content": "先确认目标文件不存在，再由根 Executor 创建并核验结果。", "input_tokens": 20, "output_tokens": 18},
      {"kind": "tool", "tool": "create_file", "arguments": {"path": "result.txt", "content": "controlled multi-agent"}, "input_tokens": 30, "output_tokens": 12},
      {"kind": "final", "content": "result.txt 已创建。", "input_tokens": 24, "output_tokens": 8}
    ],
    "rules": [
      {"kind": "runtime_status", "statuses": ["completed"]},
      {"kind": "file_exists", "path": "result.txt"},
      {"kind": "file_contains", "path": "result.txt", "value": "controlled multi-agent"},
      {"kind": "child_agent_count", "minimum": 1, "maximum": 1},
      {"kind": "agent_role", "value": "planner"},
      {"kind": "file_lock_recorded", "minimum": 1},
      {"kind": "no_unrelated_changes"}
    ],
    "expected_outcome": "passed"
  },

  {
    "id": "professional-file-organization",
    "title": "File Organizer controlled move",
    "description": "The File Organizer moves one file without exposing code-writing or shell capabilities.",
    "task_type": "files",
    "difficulty": "medium",
    "suite": "professional_agents",
    "tags": ["profile", "files", "move"],
    "prompt": "创建 archive 目录，然后把 draft.txt 移动到 archive/draft.txt，不修改文件内容。",
    "required_tools": ["create_directory", "move_file"],
    "allow_write": true,
    "agent_profile_id": "file_organizer",
    "permission_mode": "agent",
    "setup_files": {"draft.txt": "keep this content"},
    "expected_files": ["archive", "archive/draft.txt", "draft.txt"],
    "actions": [
      {"kind": "tool", "tool": "create_directory", "arguments": {"path": "archive"}},
      {"kind": "tool", "tool": "read_file", "arguments": {"path": "draft.txt"}},
      {"kind": "tool", "tool": "move_file", "arguments": {"source": "draft.txt", "destination": "archive/draft.txt", "expected_version_token": "$version_token:draft.txt", "expected_destination_version_token": "missing"}},
      {"kind": "final", "content": "draft.txt 已移动到 archive/draft.txt。"}
    ],
    "rules": [
      {"kind": "runtime_status", "statuses": ["completed"]},
      {"kind": "agent_profile", "value": "file_organizer"},
      {"kind": "file_exists", "path": "archive/draft.txt"},
      {"kind": "file_contains", "path": "archive/draft.txt", "value": "keep this content"},
      {"kind": "tool_called", "tool": "move_file", "minimum": 1},
      {"kind": "no_unrelated_changes"}
    ],
    "expected_outcome": "passed"
  },
  {
    "id": "professional-coding-write-and-verify",
    "title": "Coding Agent scoped implementation",
    "description": "Coding Agent creates one scoped source file and preserves its professional profile.",
    "task_type": "coding", "difficulty": "medium", "suite": "professional_agents",
    "tags": ["profile", "coding", "write"],
    "prompt": "创建 hello.py 和 test_hello.py，并实际运行 pytest 验证。", "required_tools": ["create_file", "run_command"],
    "allow_write": true, "allow_shell": true, "requires_confirmation": true, "auto_approve": true,
    "agent_profile_id": "coding", "permission_mode": "full", "expected_files": ["hello.py", "test_hello.py"],
    "validation_commands": ["python -m pytest -q"],
    "actions": [
      {"kind": "tool", "tool": "create_file", "arguments": {"path": "hello.py", "content": "def greeting():\n    return 'hello'\n"}},
      {"kind": "tool", "tool": "create_file", "arguments": {"path": "test_hello.py", "content": "from hello import greeting\n\ndef test_greeting():\n    assert greeting() == 'hello'\n"}},
      {"kind": "tool", "tool": "run_command", "arguments": {"command": "python", "args": ["-m", "pytest", "-q"], "timeout": 30}},
      {"kind": "final", "content": "hello.py 与测试已创建，pytest 已实际通过。"}
    ],
    "rules": [
      {"kind": "runtime_status", "statuses": ["completed"]}, {"kind": "agent_profile", "value": "coding"},
      {"kind": "file_exists", "path": "hello.py"}, {"kind": "file_exists", "path": "test_hello.py"}, {"kind": "command_succeeded"},
      {"kind": "no_unrelated_changes"}
    ], "expected_outcome": "passed"
  },

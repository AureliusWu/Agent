{
  "name": "agent-frontend",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "vite --mode desktop",
    "prebuild": "python ../scripts/generate_build_info.py --build-type Release --respect-lock",
    "build": "tsc -b && vite build",
    "prebuild:desktop": "python ../scripts/generate_build_info.py --build-type Release --respect-lock",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "lint": "oxlint",
    "test:build-info": "node --experimental-strip-types scripts/build-info.test.ts",
    "test:security": "node scripts/security-check.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-stronghold": "^2.3.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}

    "orchestration_mode": "generator_verifier",
    "agent_count": 1,
    "max_execution_seconds": 30,
    "max_tool_calls": 0,
    "max_tokens": 4000,
    "actions": [
      {"kind": "final", "content": "初稿：2。", "input_tokens": 18, "output_tokens": 6},
      {"kind": "final", "content": "{\"verdict\":\"revise\",\"summary\":\"缺少依据\",\"issues\":[\"补充计算过程\"]}", "input_tokens": 28, "output_tokens": 16},
      {"kind": "final", "content": "终稿：1+1=2，因为在整数加法中一个单位加一个单位得到两个单位。", "input_tokens": 22, "output_tokens": 18}
    ],
    "rules": [
      {"kind": "runtime_status", "statuses": ["completed"]},
      {"kind": "child_agent_count", "minimum": 1, "maximum": 1},
      {"kind": "agent_role", "value": "verifier"},
      {"kind": "verifier_revision", "minimum": 1},
      {"kind": "no_file_changes"}
    ],
    "expected_outcome": "passed"
  },
  {

# 部署模式：desktop_local / local_web / web_control / cloud_executor
AGENT_DEPLOYMENT_MODE=local_web
# desktop_local 只能使用回环地址；任何非回环监听都必须配置 API 令牌
AGENT_BIND_HOST=127.0.0.1
# 后端访问令牌：桌面端自动生成；web_control、cloud_executor 和非回环监听必须显式配置
AGENT_API_TOKEN=
# 模型主密钥仅由后端环境变量或桌面 Windows 凭据管理器持有，不得输入网页或写入前端构建
AGENT_DEEPSEEK_API_KEY=
AGENT_MODEL_BASE_URL=https://api.deepseek.com
AGENT_MODEL_NAME=deepseek-v4-flash
AGENT_MODEL_ROUTING_ENABLED=true
AGENT_MODEL_ESCALATION_ENABLED=true
AGENT_MODEL_LIGHT_NAME=deepseek-v4-flash
AGENT_MODEL_MEDIUM_NAME=deepseek-v4-flash
AGENT_MODEL_STRONG_NAME=deepseek-v4-pro
AGENT_MODEL_PRICING_JSON={}
AGENT_MAX_TASK_TOKENS=120000
AGENT_MAX_PHASE_TOKENS=60000
AGENT_MAX_MODEL_CALL_TOKENS=32000
AGENT_MAX_TOOL_RESULT_CHARS=12000
AGENT_MAX_FILE_SNIPPET_CHARS=8000
AGENT_READ_CACHE_TTL_SECONDS=120
AGENT_MULTI_AGENT_ENABLED=true
AGENT_MULTI_AGENT_MAX_CHILDREN=3
AGENT_MULTI_AGENT_MAX_CONCURRENCY=3
AGENT_MULTI_AGENT_TOTAL_TOKEN_BUDGET=24000
AGENT_MULTI_AGENT_CHILD_TOKEN_BUDGET=8000
AGENT_MULTI_AGENT_CHILD_TIMEOUT_SECONDS=45
AGENT_MULTI_AGENT_CHILD_ROUNDS=3
AGENT_MULTI_AGENT_FILE_LOCK_SECONDS=180
AGENT_EXTENSION_MAX_FILES=200
AGENT_EXTENSION_MAX_BYTES=10000000
AGENT_DATABASE_PATH=data/agent.db
# CORS 允许的来源（逗号分隔）。PWA/手机部署时需添加前端实际访问地址
# 例如：http://192.168.1.100:5173,https://your-domain.com
AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,https://tauri.localhost,tauri://localhost
AGENT_ALLOW_LOCAL_MCP=false
AGENT_ALLOW_PRIVATE_MODEL_PROVIDER=false
AGENT_NETWORK_ALLOW_HTTP=false
AGENT_NETWORK_ALLOWED_DOMAINS=
AGENT_NETWORK_BLOCKED_DOMAINS=metadata.google.internal,metadata.azure.internal,metadata.aws.internal
AGENT_NETWORK_MAX_RESPONSE_BYTES=5000000
AGENT_NETWORK_MAX_REDIRECTS=3
AGENT_SECURITY_SNAPSHOT_MAX_FILES=20000
AGENT_SECURITY_SNAPSHOT_MAX_BYTES=250000000
AGENT_SECURITY_SNAPSHOT_RETENTION=10
